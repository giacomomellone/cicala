(footprint "SW_Omron_B3F-4050" (version 20260206) (generator "pcbnew") (layer "F.Cu")
(descr "Omron B3F-4050 projected plunger, B3F datasheet p6. Top-view 12.5 x 5 mm terminal pitch; top row common pin 1, bottom row common pin 2. 2 x 1.8 mm NPTH bosses at y +/-4.5. Fit B32 after soldering.")
(property "Reference" "REF**" (at 0 -7.8) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.15))))
(property "Value" "B3F-4050" (at 0 7.8) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.15))))
(attr through_hole)
(fp_rect (start -7.75 -6.5) (end 7.75 6.5) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
(fp_rect (start -6 -6) (end 6 6) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
(fp_rect (start -1.9 -1.9) (end 1.9 1.9) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
(fp_line (start -6.2 -6.2) (end 6.2 -6.2) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
(fp_line (start -6.2 6.2) (end 6.2 6.2) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
(model "${KIPRJMOD}/models/Omron_B3F-4050.step" (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
(pad "1" thru_hole oval (at -6.25 -2.5) (size 2.4 2.0) (drill 1.2) (layers "*.Cu" "*.Mask"))
(pad "2" thru_hole oval (at -6.25 2.5) (size 2.4 2.0) (drill 1.2) (layers "*.Cu" "*.Mask"))
(pad "1" thru_hole oval (at 6.25 -2.5) (size 2.4 2.0) (drill 1.2) (layers "*.Cu" "*.Mask"))
(pad "2" thru_hole oval (at 6.25 2.5) (size 2.4 2.0) (drill 1.2) (layers "*.Cu" "*.Mask"))
(pad "" np_thru_hole circle (at 0 -4.5) (size 1.8 1.8) (drill 1.8) (layers "*.Cu" "*.Mask"))
(pad "" np_thru_hole circle (at 0 4.5) (size 1.8 1.8) (drill 1.8) (layers "*.Cu" "*.Mask"))
)
