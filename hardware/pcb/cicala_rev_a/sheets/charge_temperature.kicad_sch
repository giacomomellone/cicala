	)
	(text "J3.2 / BATT_NTC remains connected to BQ25185 TS/MR.\nSemitec 103AT-2 is bonded to the protected cell and returns to J3.3."
		(at 20.32 137.16 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "906692ce-4231-415d-9c5a-29bf1aebece2")
	)
	(text "Both comparator outputs must release TEMP_OK to permit charging.\nAn open or shorted thermistor disables charging. C33 delays permission at USB insertion.\nFirmware CHG_ENABLE high disables charging; R13 supplies the low default through Q2."
		(at 20.32 154.94 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "27418b00-23fb-4751-b4f7-0d8e004e5aea")
	)
	(text "3V3 sets the comparison thresholds; U7 and the gate pull-up run only from USB.\nThe 1.1125 Mohm reference ladder draws 2.97 uA from 3V3."
		(at 20.32 177.8 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left)
		)
		(uuid "47e6c1d8-3cbd-4649-af39-2f8b5bee2aea")
	)
