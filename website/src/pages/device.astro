---
import Base from "../layouts/Base.astro";
import { REPO_URL } from "../config";
import { t } from "../i18n";
---

<Base
  title="The device · Cicala"
  description="Work in progress. Follow Cicala’s hardware development."
>
  <article class="short-page">
    <h1 data-i18n="device.wip.title">{t("en", "device.wip.title")}</h1>
    <p data-i18n="device.wip.body">{t("en", "device.wip.body")}</p>
    <p>
      <a href={`${REPO_URL}/tree/main/hardware#readme`} data-i18n="device.wip.updates"
        >{t("en", "device.wip.updates")}</a
      >
    </p>
  </article>
</Base>
