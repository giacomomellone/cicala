---
// Browse (spec §7.5): sticky toolbar, flat rows, 100-row pagination.
import Chips from "../components/Chips.astro";
import { TAGS } from "../config";
import { t, type StringKey } from "../i18n";
import Base from "../layouts/Base.astro";
import payload from "../data/questions.en.json";
import { heartIcon } from "../lib/icons";
import type { Question } from "../lib/data";

const newestFirst = (payload.questions as Question[]).map((q) => ({ q })).reverse();
const firstPage = newestFirst.slice(0, 100);
---

<Base title="browse · cicala" lang="en">
  <h1 class="visually-hidden" data-i18n="browse.title">browse</h1>
  <div class="toolbar">
    <div class="toolbar-row">
      <input
        type="search"
        id="b-search"
        placeholder={t("en", "browse.search")}
        data-i18n-placeholder="browse.search"
        aria-label={t("en", "browse.search")}
        data-i18n-aria="browse.search"
      />
      <select id="b-tag" aria-label="tag filter">
        <option value="" data-i18n="browse.alltags">{t("en", "browse.alltags")}</option>
        {
          TAGS.map((tag) => (
            <option value={tag} data-i18n={`tag.${tag}`}>
              {t("en", `tag.${tag}` as StringKey)}
            </option>
          ))
        }
      </select>
      <select id="b-sort" aria-label="sort">
        <option value="newest" data-i18n="browse.sort.newest"
          >{t("en", "browse.sort.newest")}</option
        >
        <option value="random" data-i18n="browse.sort.random"
          >{t("en", "browse.sort.random")}</option
        >
      </select>
    </div>
    <Chips id="browse-chips" />
  </div>

  <p class="disclaimer browse-disclaimer" data-i18n="play.disclaimer">
    {t("en", "play.disclaimer")}
  </p>

  <ul class="rows" id="rows">
    {
      firstPage.map(({ q }) => (
        <li class="row" data-id={q.id}>
          <div class="row-main">
            <a class="row-q" href={`/q/${q.id}`}>
              {q.text}
            </a>
            <div class="row-meta">
              {q.decks.map((deck) => (
                <span data-i18n={`deck.${deck}`}>{t("en", `deck.${deck}` as StringKey)}</span>
              ))}
              <span data-i18n={`depth.${q.depth}`}>{t("en", `depth.${q.depth}` as StringKey)}</span>
              {q.tags.map((tag) => (
                <span data-i18n={`tag.${tag}`}>{t("en", `tag.${tag}` as StringKey)}</span>
              ))}
              {q.translated_by === "google" && q.origin && (
                <a href={`/q/${q.origin}`} data-i18n="question.translated">
                  {t("en", "question.translated")}
                </a>
              )}
            </div>
          </div>
          <button
            type="button"
            class="iconbtn row-fav"
            aria-pressed="false"
            aria-label={t("en", "play.save")}
            set:html={heartIcon}
          />
          <span data-vote-slot hidden />
        </li>
      ))
    }
  </ul>

  <div class="empty-state" id="b-empty" hidden>
    <p data-i18n="browse.empty">{t("en", "browse.empty")}</p>
    <p>
      <a href="/suggest?source=browse-empty" id="b-suggest-empty" data-i18n="browse.empty.cta">
        {t("en", "browse.empty.cta")}
      </a>
    </p>
  </div>

  <p style="text-align:center; padding:1.5rem 0">
    <button
      type="button"
      class="btn"
      id="b-more"
      hidden={newestFirst.length <= 100}
      data-i18n="browse.more">{t("en", "browse.more")}</button
    >
  </p>

  <p class="browse-suggest">
    <a href="/suggest?source=browse" data-i18n="browse.suggest">{t("en", "browse.suggest")}</a>
  </p>

  <script>
    import { initBrowse } from "../lib/browse";
    initBrowse();
  </script>
</Base>
