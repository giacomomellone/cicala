---
// Permalinks (spec §7.4): one static page per question in every shipped
// language, so /q/<id> works without JS, carries the question as <title>,
// and sets <html lang> to the question's language.
import PlayShell from "../../components/PlayShell.astro";
import type { Category } from "../../config";
import Base from "../../layouts/Base.astro";
import type { Question } from "../../lib/data";

interface Payload {
  categories: Record<string, Question[]>;
}

export function getStaticPaths() {
  const files = import.meta.glob<{ default: Payload }>(
    "../../data/questions.*.json",
    { eager: true },
  );
  const paths = [];
  for (const [path, mod] of Object.entries(files)) {
    const lang = path.match(/questions\.([a-z]{2,3})\.json$/)?.[1] ?? "en";
    for (const [category, questions] of Object.entries(mod.default.categories)) {
      for (const q of questions) {
        paths.push({ params: { id: q.id }, props: { q, category, lang } });
      }
    }
  }
  return paths;
}

interface Props {
  q: Question;
  category: string;
  lang: string;
}
const { q, category, lang } = Astro.props;
---

<Base
  title={q.text}
  description="A conversation question from the open Tischkarte database."
  lang={lang}
  seedLang={lang}
>
  <PlayShell
    question={q}
    category={category as Category}
    lang={lang}
    permalink
  />
</Base>
