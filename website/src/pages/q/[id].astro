---
// Static question permalinks include the question title and language.
import PlayShell from "../../components/PlayShell.astro";
import { REPO_URL, type Deck } from "../../config";
import { t, type Lang } from "../../i18n";
import Base from "../../layouts/Base.astro";
import type { Question } from "../../lib/data";

interface Payload {
  questions: Question[];
}

export function getStaticPaths() {
  const files = import.meta.glob<{ default: Payload }>("../../data/questions.*.json", {
    eager: true,
  });
  const paths = [];
  for (const [path, mod] of Object.entries(files)) {
    const lang = path.match(/questions\.([a-z]{2,3})\.json$/)?.[1] ?? "en";
    for (const q of mod.default.questions) {
      paths.push({
        params: { id: q.id },
        props: { q, deck: q.decks[0] ?? "new_people", lang },
      });
    }
  }
  return paths;
}

interface Props {
  q: Question;
  deck: string;
  lang: string;
}
const { q, deck, lang } = Astro.props;
/* The native form needs no GitHub account; it carries the id and resolves the
   question client-side. The issue template stays reachable from there. */
const editUrl = `/edit?q=${q.id}`;
---

<Base
  title={q.text}
  description="A conversation question from the open Cicala database."
  lang={lang}
  seedLang={lang}
>
  <PlayShell question={q} deck={deck as Deck} lang={lang} permalink />
  <p class="question-edit">
    <a href={editUrl} data-i18n="question.edit">
      {t(lang as Lang, "question.edit")}
    </a>
  </p>
</Base>

<style>
  .question-edit {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.75rem;
    color: var(--ink-faint);
  }
</style>
