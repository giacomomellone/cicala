---
// Browse/deck filters: all + the six physical decks in selector order.
// role="radiogroup" per §7.10; the active chip is inverted.
import { DECKS } from "../config";
import { t, type StringKey } from "../i18n";

interface Props {
  active?: string;
  id?: string;
}
const { active = "all", id = "chips" } = Astro.props;
const options = ["all", ...DECKS];
---

<div class="chips" role="radiogroup" aria-label="deck" id={id}>
  {
    options.map((deck) => (
      <button
        type="button"
        class="chip"
        role="radio"
        aria-checked={String(deck === active)}
        data-deck={deck}
        data-i18n={`deck.${deck}`}
      >
        {t("en", `deck.${deck}` as StringKey)}
      </button>
    ))
  }
</div>
