---
// Category chips: all + the five categories in knob order (spec §7.4).
// role="radiogroup" per §7.10; the active chip is inverted.
import { CATEGORIES } from "../config";
import { t, type StringKey } from "../i18n";

interface Props {
  active?: string;
  id?: string;
}
const { active = "all", id = "chips" } = Astro.props;
const options = ["all", ...CATEGORIES];
---

<div class="chips" role="radiogroup" aria-label="category" id={id}>
  {
    options.map((cat) => (
      <button
        type="button"
        class="chip"
        role="radio"
        aria-checked={String(cat === active)}
        data-cat={cat}
        data-i18n={`cat.${cat}`}
      >
        {t("en", `cat.${cat}` as StringKey)}
      </button>
    ))
  }
</div>
