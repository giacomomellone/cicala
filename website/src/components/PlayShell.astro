---
// The play surface, shared by / and /q/[id] (spec §7.4). Mirrors the device:
// Category cycles the five decks and names the deck, Next draws from it.
import type { Deck } from "../config";
import { t, type StringKey } from "../i18n";
import { heartIcon, shareIcon } from "../lib/icons";
import type { Question } from "../lib/data";

interface Props {
  /* Absent when the language has no playable question yet: the panel renders
     the empty state and the client draws nothing until the corpus has one. */
  question?: Question;
  deck: Deck;
  lang: string;
  /* true on /q/[id] pages — "next" transitions back to / via replaceState */
  permalink?: boolean;
}
const { question, deck, lang, permalink = false } = Astro.props;
---

<div
  class="play"
  id="play-root"
  data-seed-id={question?.id}
  data-seed-deck={deck}
  data-permalink={permalink ? "1" : "0"}
>
  <div class="panel">
    <i class="panel__floor dither" aria-hidden="true"></i>
    <span class="panel__deck" id="q-deck-name">{t("en", `deck.${deck}` as StringKey)}</span>
    <a
      class="panel__origin"
      id="q-origin"
      href={question?.origin ? `/q/${question.origin}` : "#"}
      data-i18n="question.translated"
      hidden={!(question?.translated_by === "google" && question.origin)}
      >{t("en", "question.translated")}</a
    >
    <div class="meta panel__acts" id="q-meta">
      <button
        type="button"
        class="iconbtn"
        id="q-fav"
        aria-pressed="false"
        set:html={heartIcon +
          `<span id="q-fav-label" data-i18n="play.save">${t("en", "play.save")}</span>`}
      />
      <span aria-hidden="true">·</span>
      <button
        type="button"
        class="iconbtn"
        id="q-share"
        set:html={shareIcon +
          `<span id="q-share-label" data-i18n="play.share">${t("en", "play.share")}</span>`}
      />
      <span data-vote-slot hidden></span>
    </div>
    <div class="q-zone">
      <div class="q-swap question-wrap" id="q-swap">
        <p class="question" id="q-text" aria-live="polite">
          {question ? question.text : t("en", "play.empty")}
        </p>
      </div>
    </div>
  </div>
  <div class="device-controls">
    <button type="button" class="key" id="q-category">
      <span data-i18n="play.category">{t("en", "play.category")}</span>
      <span class="key__kbd" aria-hidden="true">c</span>
    </button>
    <button type="button" class="key" id="q-next">
      <span data-i18n="play.next">{t("en", "play.next")}</span>
      <span class="key__kbd" aria-hidden="true">space</span>
    </button>
  </div>
  <p class="skip-note" data-i18n="play.skip">{t("en", "play.skip")}</p>
  <p class="card-links">
    <a href="/suggest?source=play" data-i18n="play.suggest">{t("en", "play.suggest")}</a>
    {
      permalink && question && (
        <span id="q-edit">
          <span class="card-links__dot" aria-hidden="true">
            ·
          </span>
          <a href={`/edit?q=${question.id}`} data-i18n="question.edit">
            {t("en", "question.edit")}
          </a>
        </span>
      )
    }
  </p>
</div>

<style>
  /* The panel is the e-paper analogue: one enclosed surface, a 1 px rule, and
     no radius, because the device cannot round a corner. */
  .panel {
    position: relative;
    overflow: hidden;
    flex: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    background: var(--panel);
    padding: clamp(2rem, 8vw, 3.5rem) clamp(1.1rem, 5vw, 2.5rem);
  }

  /* The dither ramps up from the bottom edge and is gone by --floor-end, so it
     never reaches the question. The tile grid is anchored to the bottom so the
     row meeting that edge is whole; the partial row lands at the top, where
     the mask has already faded it out. */
  .panel__floor {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-position: 0 100%;
    -webkit-mask-image: linear-gradient(
      0deg,
      #000 0%,
      rgb(0 0 0 / 40%) calc(var(--floor-end) * 0.45),
      transparent var(--floor-end)
    );
    mask-image: linear-gradient(
      0deg,
      #000 0%,
      rgb(0 0 0 / 40%) calc(var(--floor-end) * 0.45),
      transparent var(--floor-end)
    );
  }

  /* Both corners are chrome, so the centre line belongs to the question
     alone: the deck names the panel on the left, the actions own the right. */
  .panel__deck,
  .panel__acts {
    position: absolute;
    z-index: 1;
    top: clamp(0.55rem, 2.4vw, 0.9rem);
    transition: opacity 120ms ease;
  }

  .panel__origin {
    position: absolute;
    z-index: 1;
    /* Under the deck name, in the chrome corner. Never over .panel__floor:
       the ramp is densest at the bottom and eats small type there. */
    top: calc(clamp(0.55rem, 2.4vw, 0.9rem) + clamp(1.3rem, 4.4vw, 1.7rem));
    left: clamp(0.8rem, 3.5vw, 1.3rem);
    max-width: 12ch;
    font-family: var(--font-ui);
    font-size: 0.5625rem;
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-underline-offset: 2px;
  }

  .panel__deck {
    left: clamp(0.8rem, 3.5vw, 1.3rem);
    font-family: var(--font-ui);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-faint);
    /* Sit on the actions' optical centre, which carries 44 px of touch target. */
    margin-top: clamp(0.5rem, 2vw, 0.75rem);
  }

  .panel__acts {
    right: clamp(0.5rem, 2.6vw, 1rem);
    justify-content: flex-end;
  }

  /* Chrome follows the question through the swap rather than jumping. */
  .panel:has(.q-swap.is-fading) .panel__deck,
  .panel:has(.q-swap.is-fading) .panel__origin,
  .panel:has(.q-swap.is-fading) .panel__acts {
    opacity: 0;
  }

  /* The deck-name card already names the deck in full. */
  .panel:has(.question.is-name) .panel__deck,
  .panel:has(.question.is-name) .panel__origin {
    visibility: hidden;
  }

  .q-zone {
    position: relative;
    z-index: 1;
  }

  .q-swap {
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: opacity 120ms ease;
  }

  .q-swap.is-fading {
    opacity: 0;
  }

  /* Category and Next share a rule with the panel and with each other, and are
     sized in the proportion of the two buttons on the device. */
  .device-controls {
    display: grid;
    grid-template-columns: 1fr 2fr;
    width: 100%;
    margin-top: -1px;
  }

  .key {
    position: relative;
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--ink);
    background: var(--panel);
    border: 1px solid var(--line);
    padding: 0.95rem 0.5rem;
    min-height: 48px;
    cursor: pointer;
    text-align: center;
    /* Steps, not a fade: the panel inverts, it does not dissolve. */
    transition:
      background-color 90ms steps(1),
      color 90ms steps(1);
  }

  .key + .key {
    border-left: none;
  }

  .key:hover,
  .key:active {
    background: var(--ink);
    color: var(--panel);
  }

  /* The shortcut is engraved in the corner so the label keeps the key's
     centre. currentColor makes it invert with the key, with no second rule. */
  .key__kbd {
    position: absolute;
    left: 0.5rem;
    bottom: 0.34rem;
    font-size: 0.5rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: lowercase;
    color: currentColor;
    opacity: 0.42;
  }

  /* Touch has no keyboard, so the shortcut is noise there. */
  @media (hover: none) and (pointer: coarse) {
    .key__kbd {
      display: none;
    }
  }

  .skip-note {
    max-width: 32rem;
    margin: 0.9rem auto 0;
    color: var(--ink-soft);
    font-size: 0.75rem;
    text-align: center;
    text-wrap: balance;
  }

  .card-links {
    margin-top: 0.45rem;
    font-size: 0.75rem;
    color: var(--ink-faint);
    text-align: center;
  }

  .card-links a {
    text-underline-offset: 3px;
  }

  .card-links__dot {
    padding-inline: 0.4rem;
  }

  /* The phone becomes the panel: the sheet runs edge to edge and the header
     rule serves as its top border. */
  @media (max-width: 30rem) {
    .panel {
      border-top: none;
      border-inline: none;
      padding: 2.1rem 1.25rem 1.15rem;
    }

    .panel__deck {
      position: static;
      margin-top: 0;
      letter-spacing: 0.3em;
    }

    .panel__origin {
      position: static;
      max-width: none;
      margin-top: 0.2rem;
    }

    .panel__acts {
      top: 0.55rem;
      right: 0.55rem;
    }

    /* Thumb-sized, like the two keys on the device. */
    .key {
      border-inline: none;
      min-height: 62px;
      padding-block: 1.3rem;
    }

    .key + .key {
      border-left: 1px solid var(--line);
    }
  }

  /* The deck-name card: quiet UI type, visibly not a question. */
  .question.is-name {
    font-family: var(--font-ui);
    font-size: clamp(0.9rem, 3vw, 1.2rem);
    letter-spacing: 0.12em;
    color: var(--ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .q-swap,
    .key,
    .panel__deck,
    .panel__origin,
    .panel__acts {
      transition: none;
    }
  }
</style>

<script>
  import { initPlay } from "../lib/play";
  initPlay();
</script>
