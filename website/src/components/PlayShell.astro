---
// The play surface, shared by / and /q/[id] (spec §7.4). Mirrors the device:
// Category cycles the five decks and names the deck, Next draws from it.
import type { Deck } from "../config";
import { t, type StringKey } from "../i18n";
import { heartIcon, shareIcon } from "../lib/icons";
import type { Question } from "../lib/data";

interface Props {
  question: Question;
  deck: Deck;
  lang: string;
  /* true on /q/[id] pages — "next" transitions back to / via replaceState */
  permalink?: boolean;
}
const { question, deck, lang, permalink = false } = Astro.props;
---

<div
  class="play"
  id="play-root"
  data-seed-id={question.id}
  data-seed-deck={deck}
  data-permalink={permalink ? "1" : "0"}
>
  <div class="panel">
    <i class="panel__floor dither" aria-hidden="true"></i>
    <span class="panel__deck" id="q-deck-name">{t("en", `deck.${deck}` as StringKey)}</span>
    <div class="meta panel__acts" id="q-meta">
      <button
        type="button"
        class="iconbtn"
        id="q-fav"
        aria-pressed="false"
        set:html={heartIcon +
          `<span id="q-fav-label" data-i18n="play.save">${t("en", "play.save")}</span>`}
      />
      <span aria-hidden="true">·</span>
      <button
        type="button"
        class="iconbtn"
        id="q-share"
        set:html={shareIcon +
          `<span id="q-share-label" data-i18n="play.share">${t("en", "play.share")}</span>`}
      />
      <span data-vote-slot hidden></span>
    </div>
    <div class="q-zone">
      <div class="q-swap question-wrap" id="q-swap">
        <p class="question" id="q-text" aria-live="polite">{question.text}</p>
      </div>
    </div>
    <p class="panel__stamp" data-i18n="play.disclaimer.short">
      {t("en", "play.disclaimer.short")}
    </p>
  </div>
  <div class="device-controls">
    <button type="button" class="key" id="q-category" data-i18n="play.category">
      {t("en", "play.category")}
    </button>
    <button type="button" class="key" id="q-next" data-i18n="play.next">
      {t("en", "play.next")}
    </button>
  </div>
  <p class="hint" data-i18n="play.hint">{t("en", "play.hint")}</p>
  <p class="skip-note" data-i18n="play.skip">{t("en", "play.skip")}</p>
  <p class="disclaimer" data-i18n="play.disclaimer">{t("en", "play.disclaimer")}</p>
  <p class="suggest-context">
    <a href="/suggest?source=play" data-i18n="play.suggest">{t("en", "play.suggest")}</a>
  </p>
</div>

<style>
  /* The panel is the e-paper analogue: one enclosed surface, a 1 px rule, and
     no radius, because the device cannot round a corner. */
  .panel {
    position: relative;
    overflow: hidden;
    flex: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    background: var(--panel);
    padding: clamp(2rem, 8vw, 3.5rem) clamp(1.1rem, 5vw, 2.5rem);
  }

  /* The dither ramps up from the bottom edge and is gone by --floor-end, so it
     never reaches the question. */
  .panel__floor {
    position: absolute;
    inset: 0;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(
      0deg,
      #000 0%,
      rgb(0 0 0 / 40%) calc(var(--floor-end) * 0.45),
      transparent var(--floor-end)
    );
    mask-image: linear-gradient(
      0deg,
      #000 0%,
      rgb(0 0 0 / 40%) calc(var(--floor-end) * 0.45),
      transparent var(--floor-end)
    );
  }

  /* Both corners are chrome, so the centre line belongs to the question
     alone: the deck names the panel on the left, the actions own the right. */
  .panel__deck,
  .panel__acts {
    position: absolute;
    z-index: 1;
    top: clamp(0.55rem, 2.4vw, 0.9rem);
    transition: opacity 120ms ease;
  }

  .panel__deck {
    left: clamp(0.8rem, 3.5vw, 1.3rem);
    font-family: var(--font-ui);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-faint);
    /* Sit on the actions' optical centre, which carries 44 px of touch target. */
    margin-top: clamp(0.5rem, 2vw, 0.75rem);
  }

  .panel__acts {
    right: clamp(0.5rem, 2.6vw, 1rem);
    justify-content: flex-end;
  }

  /* Chrome follows the question through the swap rather than jumping. */
  .panel:has(.q-swap.is-fading) .panel__deck,
  .panel:has(.q-swap.is-fading) .panel__acts {
    opacity: 0;
  }

  /* The deck-name card already names the deck in full. */
  .panel:has(.question.is-name) .panel__deck {
    visibility: hidden;
  }

  .q-zone {
    position: relative;
    z-index: 1;
  }

  .q-swap {
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: opacity 120ms ease;
  }

  .q-swap.is-fading {
    opacity: 0;
  }

  /* Category and Next share a rule with the panel and with each other, and are
     sized in the proportion of the two buttons on the device. */
  .device-controls {
    display: grid;
    grid-template-columns: 1fr 2fr;
    width: 100%;
    margin-top: -1px;
  }

  .key {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--ink);
    background: var(--panel);
    border: 1px solid var(--line);
    padding: 0.95rem 0.5rem;
    min-height: 48px;
    cursor: pointer;
    text-align: center;
    /* Steps, not a fade: the panel inverts, it does not dissolve. */
    transition:
      background-color 90ms steps(1),
      color 90ms steps(1);
  }

  .key + .key {
    border-left: none;
  }

  .key:hover,
  .key:active {
    background: var(--ink);
    color: var(--panel);
  }

  .hint {
    margin-top: 0.9rem;
    text-align: center;
  }

  /* Touch has no keyboard, so the shortcut line is noise there. */
  @media (hover: none) and (pointer: coarse) {
    .hint {
      display: none;
    }
  }

  .disclaimer {
    margin-top: 0.9rem;
  }

  .skip-note {
    max-width: 32rem;
    margin: 0.35rem auto 0;
    color: var(--ink-soft);
    font-size: 0.75rem;
    text-align: center;
    text-wrap: balance;
  }

  .skip-note + .disclaimer {
    margin-top: 0.45rem;
  }

  .suggest-context {
    margin-top: 0.45rem;
    font-size: 0.75rem;
    color: var(--ink-faint);
  }

  .suggest-context a {
    text-underline-offset: 3px;
  }

  /* Provenance printed on the sheet itself, under a tear line drawn from the
     same dither grid. The phone shows this; wider screens show the sentence
     under the keys instead, and never both. */
  .panel__stamp {
    position: relative;
    z-index: 1;
    display: none;
    align-self: stretch;
    margin-top: auto;
    padding-top: 0.7rem;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-faint);
    border-top: var(--dither-px) solid transparent;
    border-image: repeating-linear-gradient(
        90deg,
        var(--ink-faint) 0 var(--dither-px),
        transparent var(--dither-px) calc(var(--dither-px) * 2)
      )
      2;
  }

  /* The phone becomes the panel: the sheet runs edge to edge and the header
     rule serves as its top border. */
  @media (max-width: 30rem) {
    /* The tear line above the stamp is the bottom edge here, so the ramp would
       only sit under the text and swallow it. */
    .panel__floor {
      display: none;
    }

    .panel {
      border-top: none;
      border-inline: none;
      padding: 2.1rem 1.25rem 1.15rem;
    }

    .panel__deck {
      position: static;
      margin-top: 0;
      letter-spacing: 0.3em;
    }

    .panel__acts {
      top: 0.55rem;
      right: 0.55rem;
    }

    .panel__stamp {
      display: block;
    }

    /* Thumb-sized, like the two keys on the device. */
    .key {
      border-inline: none;
      min-height: 62px;
      padding-block: 1.3rem;
    }

    .key + .key {
      border-left: 1px solid var(--line);
    }

    .disclaimer {
      display: none;
    }

    .skip-note {
      margin-top: 0.9rem;
    }
  }

  /* The deck-name card: quiet UI type, visibly not a question. */
  .question.is-name {
    font-family: var(--font-ui);
    font-size: clamp(0.9rem, 3vw, 1.2rem);
    letter-spacing: 0.12em;
    color: var(--ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .q-swap,
    .key,
    .panel__deck,
    .panel__acts {
      transition: none;
    }
  }
</style>

<script>
  import { initPlay } from "../lib/play";
  initPlay();
</script>
