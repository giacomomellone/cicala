# Cloudflare Pages / Netlify-style headers. Harmless on other hosts —
# GitHub Pages ignores this file (spec: keep the build host-agnostic).

# Content-hashed assets (includes the per-language question payloads)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Device sync manifest + bundles must always revalidate
/device/manifest.json
  Cache-Control: public, max-age=300, must-revalidate
