# python
.venv/
__pycache__/
*.pyc

# node / astro
node_modules/
website/dist/
website/.astro/

# playwright output (traces and screenshots of failed e2e runs)
website/test-results/
website/playwright-report/
website/.dev.vars*
website/.env*
website/_worker.bundle

# generated data (rebuilt by tools/build_site_data.py in CI)
website/src/data/*.json

# generated bundles: dist/corpus/ holds the newest shipped bundle per language,
# dist/test-bundles/ the same for the fixture corpus under firmware/tests/corpus/
dist/bundles/
dist/corpus/
dist/test-bundles/
dist/cicala-core-*.tar.gz*

# question drafts — working notes for `just draft`, not the database itself
drafts/

# west workspace — zephyr and its modules, cloned by `just fw-init`.
# deps/.clang-format is committed on purpose: it stops an editor from
# reformatting Zephyr sources on save.
.west/
deps/*
!deps/.clang-format

# firmware build output (west build -d build/...)
build/

# test fixtures, regenerated by `just fw-test` from firmware/tests/corpus/
firmware/tests/fixtures/

# mkdocs output
site/

# KiCad per-user state, locks and automatic backups
*.kicad_prl
~*.lck
*-backups/
*.kicad_sch-bak
*.kicad_pcb-bak
# KiCad "Local History" plugin keeps its own nested git repo; never commit it
.history/

# vendored docs dependency, fetched by `just docs-deps` (pinned there).
# Not committed, for the same reason node_modules/ is not.
docs/assets/javascripts/mermaid.min.js

# direnv's cached dev shell (.envrc / flake.nix are committed; this is local
# state, and it pins store paths a `nix flake update` invalidates)
.direnv/

# os
.DS_Store

# secrets — never commit private keys
*.pem
signing_key*

# The one exception, and it is not a secret: the development firmware-signing
# key, whose whole purpose is to be in the tree so a local build produces an
# image the local bootloader accepts. Every release is signed with the
# FIRMWARE_SIGNING_KEY secret instead. firmware/keys/README.md says so at
# length; do not add a second exception here.
!firmware/keys/firmware-signing-dev.pem
