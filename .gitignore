# python
.venv/
__pycache__/
*.pyc

# node / astro
node_modules/
website/dist/
website/.astro/

# generated data (rebuilt by tools/build_site_data.py in CI)
website/src/data/*.json

# generated bundles
dist/bundles/

# west workspace — zephyr and its modules, cloned by `just fw-init`.
# deps/.clang-format is committed on purpose: it stops an editor from
# reformatting Zephyr sources on save.
.west/
deps/*
!deps/.clang-format

# firmware build output (west build -d build/...)
build/

# test fixtures, regenerated by `just fw-fixtures` from the question database
firmware/tests/fixtures/

# mkdocs output
site/

# os
.DS_Store

# secrets — never commit private keys
*.pem
signing_key*
