
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    aliases {
        kveld-category = &kveld_category;
        kveld-next = &kveld_next;
        kveld-led-red = &led_red;
        kveld-led-green = &led_green;
    };

    adc0: adc {
        compatible = "zephyr,adc-emul";
        nchannels = <1>;
        ref-internal-mv = <3300>;
        #io-channel-cells = <1>;
        #address-cells = <1>;
        #size-cells = <0>;
        status = "okay";

        channel@0 {
            reg = <0>;
            zephyr,gain = "ADC_GAIN_1";
            zephyr,reference = "ADC_REF_INTERNAL";
            zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
            zephyr,resolution = <12>;
        };
    };

    zephyr,user {
        io-channels = <&adc0 0>;
        kveld-vbus-gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>;
    };

    kveld_leds: kveld-leds {
        compatible = "gpio-leds";
        led_red: red { gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>; label = "status red"; };
        led_green: green { gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>; label = "status green"; };
    };

    gpio0: gpio_emul {
        compatible = "zephyr,gpio-emul";
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <32>;
        rising-edge;
        falling-edge;
        high-level;
        low-level;
    };

    kveld_buttons: kveld-buttons {
        compatible = "gpio-keys";
        debounce-interval-ms = <30>;
        kveld_category: category { gpios = <&gpio0 0 GPIO_ACTIVE_LOW>; zephyr,code = <INPUT_KEY_MENU>; label = "category"; };
        kveld_next: next { gpios = <&gpio0 6 GPIO_ACTIVE_LOW>; zephyr,code = <INPUT_KEY_ENTER>; label = "next"; };
    };

    kveld_dummy: dummy_dc {
        compatible = "zephyr,dummy-dc";
        width = <250>;
        height = <122>;
        status = "okay";
    };

    chosen {
        zephyr,display = &kveld_dummy;
    };
};
