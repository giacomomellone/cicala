/*
 * Same nodes as the qemu overlay beside this one, minus the emulated GPIO
 * controller: native_sim's own devicetree already provides gpio0, which is why
 * this only references it.
 */

#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    aliases {
        tk-category = &tk_category;
        tk-next = &tk_next;
    };

    tk_buttons: tk-buttons {
        compatible = "gpio-keys";
        debounce-interval-ms = <30>;
        tk_category: category { gpios = <&gpio0 0 GPIO_ACTIVE_LOW>; zephyr,code = <INPUT_KEY_MENU>; label = "category"; };
        tk_next: next { gpios = <&gpio0 6 GPIO_ACTIVE_LOW>; zephyr,code = <INPUT_KEY_ENTER>; label = "next"; };
    };

    /*
     * A dummy panel the size of the real one. Without a display chosen here,
     * Zephyr falls back to the SDL driver on this platform, which needs a host
     * library and shows nothing useful anyway.
     */
    tk_dummy: dummy_dc {
        compatible = "zephyr,dummy-dc";
        width = <250>;
        height = <122>;
        status = "okay";
    };

    chosen {
        zephyr,display = &tk_dummy;
    };

};
