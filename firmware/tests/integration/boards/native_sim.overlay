/*
 * Same nodes as the qemu overlay beside this one, minus the emulated GPIO
 * controller: native_sim's own devicetree already provides gpio0, which is why
 * this only references it.
 */

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    aliases {
        tk-category = &tk_category;
        tk-next = &tk_next;
        tk-led-red = &led_red;
        tk-led-green = &led_green;
    };

    /* See the qemu overlay beside this one for what adc_emul is doing here,
     * and why the channel child is not optional. */
    adc0: adc {
        compatible = "zephyr,adc-emul";
        nchannels = <1>;
        ref-internal-mv = <3300>;
        #io-channel-cells = <1>;
        #address-cells = <1>;
        #size-cells = <0>;
        status = "okay";

        channel@0 {
            reg = <0>;
            zephyr,gain = "ADC_GAIN_1";
            zephyr,reference = "ADC_REF_INTERNAL";
            zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
            zephyr,resolution = <12>;
        };
    };

    zephyr,user {
        io-channels = <&adc0 0>;
        tk-vbus-gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>;
    };

    tk_leds: tk-leds {
        compatible = "gpio-leds";
        led_red: red { gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>; label = "status red"; };
        led_green: green { gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>; label = "status green"; };
    };

    tk_buttons: tk-buttons {
        compatible = "gpio-keys";
        debounce-interval-ms = <30>;
        tk_category: category { gpios = <&gpio0 0 GPIO_ACTIVE_LOW>; zephyr,code = <INPUT_KEY_MENU>; label = "category"; };
        tk_next: next { gpios = <&gpio0 6 GPIO_ACTIVE_LOW>; zephyr,code = <INPUT_KEY_ENTER>; label = "next"; };
    };

    /*
     * A dummy panel the size of the real one. Without a display chosen here,
     * Zephyr falls back to the SDL driver on this platform, which needs a host
     * library and shows nothing useful anyway.
     */
    tk_dummy: dummy_dc {
        compatible = "zephyr,dummy-dc";
        width = <250>;
        height = <122>;
        status = "okay";
    };

    chosen {
        zephyr,display = &tk_dummy;
    };

};

/*
 * native_sim's own devicetree enables an SDL display and chooses it. Adding a
 * dummy is not enough: the SDL node stays `okay`, so its driver is still built
 * and CMake still looks for the host library. Disabling it is what makes the
 * dummy the only display, and what lets these suites run on a machine with no
 * SDL at all.
 */
&sdl_dc {
    status = "disabled";
};
