
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    aliases {
        cicala-category = &cicala_category;
        cicala-next = &cicala_next;
    };

    gpio0: gpio_emul {
        compatible = "zephyr,gpio-emul";
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <32>;
        rising-edge;
        falling-edge;
        high-level;
        low-level;
    };

    cicala_buttons: cicala-buttons {
        compatible = "gpio-keys";
        debounce-interval-ms = <30>;
        cicala_category: category { gpios = <&gpio0 0 GPIO_ACTIVE_LOW>; zephyr,code = <INPUT_KEY_MENU>; label = "category"; };
        cicala_next: next { gpios = <&gpio0 6 GPIO_ACTIVE_LOW>; zephyr,code = <INPUT_KEY_ENTER>; label = "next"; };
    };

    cicala_dummy: dummy_dc {
        compatible = "zephyr,dummy-dc";
        width = <250>;
        height = <122>;
        status = "okay";
    };

    chosen {
        zephyr,display = &cicala_dummy;
    };
};
