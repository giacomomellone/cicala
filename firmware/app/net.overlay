/*
 * The second Wi-Fi interface.
 *
 * The board already enables `&wifi`, which is the station. AP+STA needs a
 * second network device: the driver defines the access point as instance 1 of
 * the same compatible, so without a second node there is no AP interface and
 * `net_if_get_wifi_sap()` quietly hands back the station one instead. Nothing
 * warns — the DHCP server then binds to the wrong interface and the portal is
 * unreachable — which is why src/net.c asserts the two are not the same.
 *
 * Merged only by `just fw-net`. See app/net.conf.
 */

/ {
    wifi_ap: wifi_ap {
        compatible = "espressif,esp32-wifi";
        status = "okay";
    };
};
