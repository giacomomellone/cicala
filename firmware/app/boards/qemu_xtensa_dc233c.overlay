/*
 * qemu build. The dc233c board has no GPIO controller of its own, so the pins
 * come from Zephyr's emulated controller — enough for the same source to build
 * and for gdb to step through the state machine on an Xtensa core.
 *
 * Two buttons, as on the target: Category advances the deck, Next asks a
 * question. The six-input selector this used to describe is gone, and so is
 * the pin numbering that went with it — only the aliases have to match, since
 * nothing under qemu cares which emulated pin a contact sits on.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    aliases {
        tk-category = &tk_category;
        tk-next = &tk_next;
    };

    gpio0: gpio_emul {
        compatible = "zephyr,gpio-emul";
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <32>;
        rising-edge;
        falling-edge;
        high-level;
        low-level;
    };

    tk_buttons: tk-buttons {
        compatible = "gpio-keys";
        debounce-interval-ms = <30>;
        tk_category: category {
            gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
            zephyr,code = <INPUT_KEY_MENU>;
            label = "category";
        };
        tk_next: next {
            gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;
            zephyr,code = <INPUT_KEY_ENTER>;
            label = "next";
        };
    };

    /* Bring-up blinky pin, so src/main.c builds for qemu too. */
    zephyr,user {
        blink-gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>;
    };

    /*
     * A dummy panel the size of the real one. It discards what it is given, so
     * `just fw-sim` proves the render path runs end to end without showing
     * anything — the image itself needs the panel on a bench.
     */
    tk_dummy: dummy_dc {
        compatible = "zephyr,dummy-dc";
        width = <250>;
        height = <122>;
        status = "okay";
    };

    chosen {
        zephyr,display = &tk_dummy;
    };
};
