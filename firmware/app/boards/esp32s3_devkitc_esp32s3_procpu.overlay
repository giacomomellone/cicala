/* ESP32-S3-DevKitC-1 breadboard rig. */

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    aliases {
        tk-category = &tk_category;
        tk-next = &tk_next;
        tk-led-red = &led_red;
        tk-led-green = &led_green;
    };

    zephyr,user {
        /* The onboard addressable LED, which this firmware never drives. */
        ws2812-gpios = <&gpio1 16 GPIO_ACTIVE_HIGH>;

        /* Battery sense: the tap of a 470k/470k divider off the charger's BAT pad, with 100 nF to ground. */
        io-channels = <&adc0 0>;

        /* A 100 kΩ/150 kΩ divider puts about 3.0 V on this VBUS input. */
        tk-vbus-gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
    };

    /* The status LEDs, each through its own resistor to ground. */
    tk_leds: tk-leds {
        compatible = "gpio-leds";
        led_red: red {
            gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
            label = "status red";
        };
        led_green: green {
            gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
            label = "status green";
        };
    };

    /* The two buttons. */
    tk_buttons: tk-buttons {
        compatible = "gpio-keys";
        debounce-interval-ms = <30>;
        tk_category: category {
            gpios = <&gpio0 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            zephyr,code = <INPUT_KEY_MENU>;
            label = "category";
        };
        tk_next: next {
            gpios = <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            zephyr,code = <INPUT_KEY_ENTER>;
            label = "next";
        };
    };
};

/* Waveshare 2.13 inch e-Paper HAT — 250 x 122, SSD1680 controller. */
&spi2 {
    status = "okay";
    pinctrl-0 = <&spim2_default>;
    pinctrl-names = "default";
    cs-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
};

/ {
    tk_mipi_dbi: mipi-dbi {
        compatible = "zephyr,mipi-dbi-spi";
        spi-dev = <&spi2>;
        dc-gpios = <&gpio0 18 GPIO_ACTIVE_HIGH>;
        /* Not 19 and 20: those are native USB D-/D+. */
        reset-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
        #address-cells = <1>;
        #size-cells = <0>;
        status = "okay";

        tk_epaper: ssd16xxfb@0 {
            compatible = "gooddisplay,gdey0213b74", "solomon,ssd1680";
            reg = <0>;
            mipi-max-frequency = <4000000>;
            width = <250>;
            height = <122>;
            busy-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
            tssv = <0x80>;
            status = "okay";

            full {
                border-waveform = <0x05>;
            };

            partial {
                border-waveform = <0x3c>;
            };
        };
    };

    chosen {
        zephyr,display = &tk_epaper;
    };
};

/* The second Wi-Fi interface. */
/ {
    wifi_ap: wifi_ap {
        compatible = "espressif,esp32-wifi";
        status = "okay";
    };
};
/* sys_poweroff() enters the disabled deep-sleep state directly. */

&light_sleep {
    status = "disabled";
};

/* Battery sense. */
&adc0 {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@0 {
        reg = <0>;
        zephyr,gain = "ADC_GAIN_1_4";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };
};

/* Where a synced corpus lives. */
&flash0 {
    partitions {
        tk_corpus_partition: partition@400000 {
            label = "corpus";
            reg = <0x400000 DT_SIZE_K(512)>;
        };
    };
};

/ {
    fstab {
        compatible = "zephyr,fstab";

        tk_corpus_fs: tk_corpus_fs {
            compatible = "zephyr,fstab,littlefs";
            mount-point = "/corpus";
            partition = <&tk_corpus_partition>;
            automount;
            read-size = <16>;
            prog-size = <16>;
            cache-size = <64>;
            lookahead-size = <32>;
            block-cycles = <512>;
        };
    };
};
