/*
 * ESP32-S3-DevKitC-1 breadboard rig.
 *
 * Pin assignment, and why each one:
 *
 *   selector 0..5   GPIO 4, 5, 6, 7, 15, 16
 *   Next            GPIO 17
 *   blink           GPIO 2
 *   e-paper         GPIO 10 CS, 11 MOSI, 12 SCLK, 13 MISO (the board's own
 *                   spim2_default), 18 D/C, 8 RESET, 9 BUSY
 *   VBUS detect     GPIO 21, reserved
 *   battery sense   GPIO 1, reserved (ADC1_CH0)
 *
 * The binding constraint is deep sleep: all seven wake inputs, and later VBUS
 * detect, must be RTC-capable or EXT1 wake is impossible. On the ESP32-S3 that
 * means GPIO0..21, which every input above satisfies. Avoided within that
 * range: GPIO0 and GPIO3 are strapping pins, and GPIO19/GPIO20 are the native
 * USB D-/D+ pair — the same peripheral app/debug.overlay puts the debug
 * console on and OpenOCD debugs through, so the panel's RESET and BUSY sit on
 * 8 and 9 instead.
 *
 * The last two have no nodes here because nothing reads them yet. They are
 * named so the deep-sleep and power work finds the range already divided:
 * battery sense has to be ADC1 (GPIO1..10) because ADC2 is unusable while
 * Wi-Fi is up, and GPIO1 is the only channel of those ten still free. VBUS
 * detect is digital, so it takes GPIO21 and leaves that channel alone. See
 * docs/hardware_wiring.md, including the divider VBUS needs off the 5 V rail.
 *
 * A six-way DIP switch and a through-hole button are valid bring-up
 * substitutes for the SRBV160803 and KSC321G. Wire each one to GND: the pins
 * are active low with internal pull-ups, so closed reads as pressed.
 *
 * The one number here still taken on faith is the panel wiring, which has not
 * been on a bench yet.
 */

#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    aliases {
        tk-next = &tk_next;
    };

    /*
     * Bring-up only, read by src/main.c. The DevKitC-1's single onboard LED is
     * an addressable WS2812 on GPIO48, so there is no `led0` alias to reuse —
     * wire a discrete LED and resistor from this pin to GND.
     */
    zephyr,user {
        blink-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
    };

    /*
     * Six one-hot selector contacts, active low with internal pull-ups.
     * Index order is the absolute selector order and must match
     * questions/schema.json x-tischkarte.decks:
     *   0 new_people, 1 close, 2 family, 3 work, 4 here, 5 wild
     */
    tk_selector: tk-selector {
        compatible = "gpio-keys";
        /*
         * Per-contact debounce, done by the in-tree driver. The 600 ms
         * one-hot settle on top of it is CONFIG_TK_SELECTOR_SETTLE_MS in
         * src/input.c — devicetree is processed before Kconfig, so a policy
         * value cannot be referenced from here.
         */
        debounce-interval-ms = <30>;
        tk_deck_0: deck_0 {
            gpios = <&gpio0 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            zephyr,code = <INPUT_BTN_0>;
            label = "new_people";
        };
        tk_deck_1: deck_1 {
            gpios = <&gpio0 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            zephyr,code = <INPUT_BTN_1>;
            label = "close";
        };
        tk_deck_2: deck_2 {
            gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            zephyr,code = <INPUT_BTN_2>;
            label = "family";
        };
        tk_deck_3: deck_3 {
            gpios = <&gpio0 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            zephyr,code = <INPUT_BTN_3>;
            label = "work";
        };
        tk_deck_4: deck_4 {
            gpios = <&gpio0 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            zephyr,code = <INPUT_BTN_4>;
            label = "here";
        };
        tk_deck_5: deck_5 {
            gpios = <&gpio0 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            zephyr,code = <INPUT_BTN_5>;
            label = "wild";
        };
    };

    /* Next is independent of the selector: pressing cannot disturb the deck. */
    tk_buttons: tk-buttons {
        compatible = "gpio-keys";
        /* Matches CONFIG_TK_NEXT_DEBOUNCE_MS; see the note above. */
        debounce-interval-ms = <30>;
        tk_next: next {
            gpios = <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
            zephyr,code = <INPUT_KEY_ENTER>;
            label = "next";
        };
    };
};

/*
 * Waveshare 2.13 inch e-Paper HAT — 250 x 122, SSD1680 controller.
 *
 * The compatible below matches the V3 and V4 revisions, which are the ones
 * sold now. Older stock is not the same panel and will not init with this
 * profile; check the marking on the board and switch the compatible to match:
 *
 *   V3 / V4   gooddisplay,gdey0213b74 + solomon,ssd1680   250 x 122   (here)
 *   V2        gooddisplay,gdeh0213b72 + solomon,ssd1675a  250 x 120
 *   V1        gooddisplay,gdeh0213b1  + solomon,ssd1673   250 x 120
 *
 * The older two are 120 rows rather than 122, so CONFIG_TK_PANEL_LINES stays
 * at 7 either way but the height property has to change with the compatible.
 *
 * Zephyr ships the driver and a waveshare_epaper_gdey0213b74 shield. The
 * shield targets Arduino headers the DevKitC does not have, so the panel is
 * described here —
 * but the structure is copied from it, because in this Zephyr the driver sits
 * behind MIPI-DBI rather than on SPI directly. The display node is a child of
 * a `zephyr,mipi-dbi-spi` node that owns the SPI bus and the D/C and reset
 * pins; putting those properties on the display node itself is the older
 * binding and does not bind at all here.
 *
 * The `full` and `partial` children are not decoration: ssd16xx offers partial
 * refresh only when a partial profile exists, and then selects between them by
 * whether blanking is on. See app/src/panel.cpp.
 */
&spi2 {
    status = "okay";
    pinctrl-0 = <&spim2_default>;
    pinctrl-names = "default";
    cs-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
};

/ {
    tk_mipi_dbi: mipi-dbi {
        compatible = "zephyr,mipi-dbi-spi";
        spi-dev = <&spi2>;
        dc-gpios = <&gpio0 18 GPIO_ACTIVE_HIGH>;
        /* Not 19 and 20: those are native USB D-/D+. See the header. */
        reset-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
        #address-cells = <1>;
        #size-cells = <0>;
        status = "okay";

        tk_epaper: ssd16xxfb@0 {
            compatible = "gooddisplay,gdey0213b74", "solomon,ssd1680";
            reg = <0>;
            mipi-max-frequency = <4000000>;
            width = <250>;
            height = <122>;
            busy-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
            tssv = <0x80>;
            status = "okay";

            full {
                border-waveform = <0x05>;
            };

            partial {
                border-waveform = <0x3c>;
            };
        };
    };

    chosen {
        zephyr,display = &tk_epaper;
    };
};
