/* Host build. */

#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    aliases {
        kveld-category = &kveld_category;
        kveld-next = &kveld_next;
    };

    kveld_buttons: kveld-buttons {
        compatible = "gpio-keys";
        debounce-interval-ms = <30>;
        kveld_category: category {
            gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
            zephyr,code = <INPUT_KEY_MENU>;
            label = "category";
        };
        kveld_next: next {
            gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
            zephyr,code = <INPUT_KEY_ENTER>;
            label = "next";
        };
    };

    chosen {
        zephyr,display = &dummy_dc;
    };

    dummy_dc: dummy_dc {
        compatible = "zephyr,dummy-dc";
        width = <250>;
        height = <122>;
        status = "okay";
    };
};

/* native_sim's own devicetree enables an SDL display and chooses it. */
&sdl_dc {
    status = "disabled";
};
