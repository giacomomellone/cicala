/*
 * Host build. GPIO is emulated so the two buttons can be driven without
 * hardware; the display is a dummy that accepts writes and discards them.
 *
 * Two buttons, as on the target: Category advances the deck, Next asks a
 * question. The six-input selector this used to describe is gone, and so is
 * the pin numbering that went with it — nothing on this platform cares which
 * emulated pin a contact sits on, only that the aliases exist.
 */

#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    aliases {
        tk-category = &tk_category;
        tk-next = &tk_next;
    };

    tk_buttons: tk-buttons {
        compatible = "gpio-keys";
        debounce-interval-ms = <30>;
        tk_category: category {
            gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
            zephyr,code = <INPUT_KEY_MENU>;
            label = "category";
        };
        tk_next: next {
            gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
            zephyr,code = <INPUT_KEY_ENTER>;
            label = "next";
        };
    };

    /* Bring-up blinky pin, so src/main.c builds for the host too. */
    zephyr,user {
        blink-gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>;
    };

    chosen {
        zephyr,display = &dummy_dc;
    };

    dummy_dc: dummy_dc {
        compatible = "zephyr,dummy-dc";
        width = <250>;
        height = <122>;
        status = "okay";
    };
};

/*
 * native_sim's own devicetree enables an SDL display and chooses it. Choosing
 * the dummy above is not enough on its own: the SDL node stays `okay`, so its
 * driver is still built and CMake still looks for a host library this
 * application has no use for.
 */
&sdl_dc {
    status = "disabled";
};
