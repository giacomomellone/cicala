{
  // ----------------------------------------------------------- toolchain
  // Adjust these two after `just fw-init` — the exact SDK version and the
  // per-architecture gdb names change between Zephyr SDK releases.
  // Find them with:  ls ~/zephyr-sdk-*/ | grep zephyr-elf
  "tischkarte.zephyrSdk": "${env:HOME}/zephyr-sdk-0.17.0",
  "tischkarte.gdbTarget": "${env:HOME}/zephyr-sdk-0.17.0/xtensa-espressif_esp32s3_zephyr-elf/bin/xtensa-espressif_esp32s3_zephyr-elf-gdb",
  "tischkarte.gdbSim": "${env:HOME}/zephyr-sdk-0.17.0/xtensa-dc233c_zephyr-elf/bin/xtensa-dc233c_zephyr-elf-gdb",

  // ------------------------------------------------------------ formatting
  "editor.formatOnSave": true,
  "[c]": { "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd" },
  "[cpp]": { "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd" },
  "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[astro]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

  // questions/*.yaml is tool-managed: tools/validate.py --fix owns its exact
  // formatting, key order and header. Never let an editor rewrite it.
  "[yaml]": { "editor.formatOnSave": false },

  // ----------------------------------------------------------------- clangd
  // clangd reads build/esp32s3/compile_commands.json, which `just fw-build`
  // generates. It respects deps/.clang-format (DisableFormat: true), so
  // opening a Zephyr source file cannot reformat it on save.
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build/esp32s3",
    "--background-index",
    "--clang-tidy=false",
    "--header-insertion=never"
  ],

  // ------------------------------------------------------------------ noise
  // deps/ is the west workspace: zephyr plus modules, several GB, not ours.
  "files.watcherExclude": {
    "**/deps/**": true,
    "**/build/**": true,
    "**/.venv/**": true,
    "**/node_modules/**": true
  },
  "search.exclude": {
    "deps": true,
    "build": true,
    "site": true,
    "website/dist": true,
    "dist": true
  },

  "files.associations": {
    "*.overlay": "dts",
    "*.dtsi": "dts",
    "prj.conf": "properties",
    "*.conf": "properties",
    "Kconfig*": "kconfig"
  }
}
