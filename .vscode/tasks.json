{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "fw: build (esp32s3)",
      "type": "shell",
      "command": "just fw-build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "fw: flash",
      "type": "shell",
      "command": "just fw-flash",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "fw: monitor",
      "type": "shell",
      "command": "just fw-monitor",
      "problemMatcher": []
    },
    {
      "label": "fw: test",
      "type": "shell",
      "command": "just fw-test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "fw: build sim (native_sim)",
      "type": "shell",
      "command": "just simboard=native_sim fw-sim",
      "problemMatcher": ["$gcc"]
    },
    {
      // Mark the background task ready when qemu starts its gdb server.
      "label": "fw: sim debugserver",
      "type": "shell",
      "command": "just fw-sim-debug",
      "isBackground": true,
      "problemMatcher": {
        "pattern": [{ "regexp": ".", "file": 1, "location": 2, "message": 3 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*(qemu|gdbserver|listening|1234).*"
        }
      }
    },
    {
      "label": "fw: flash (debug -Og)",
      "type": "shell",
      "command": "just fw-flash debug",
      "problemMatcher": ["$gcc"]
    },
    {
      // The debug console uses CDC-ACM on the native USB jack.
      "label": "fw: monitor (debug, USB jack)",
      "type": "shell",
      "command": "just fw-monitor debug",
      "presentation": { "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      // Build, flash, and serve the same -Og image in one just invocation.
      "label": "fw: openocd server",
      "type": "shell",
      "command": "just fw-debug",
      "isBackground": true,
      "problemMatcher": {
        "pattern": [{ "regexp": ".", "file": 1, "location": 2, "message": 3 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Open On-Chip Debugger.*",
          "endsPattern": ".*Listening on port 3333.*"
        }
      }
    },
    {
      "label": "fmt: all",
      "type": "shell",
      "command": "just fmt",
      "problemMatcher": []
    },
    {
      "label": "test: everything",
      "type": "shell",
      "command": "just test",
      "problemMatcher": []
    }
  ]
}
