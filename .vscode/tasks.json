{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "fw: build (esp32s3)",
      "type": "shell",
      "command": "just fw-build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "fw: flash",
      "type": "shell",
      "command": "just fw-flash",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "fw: monitor",
      "type": "shell",
      "command": "just fw-monitor",
      "problemMatcher": []
    },
    {
      "label": "fw: test",
      "type": "shell",
      "command": "just fw-test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "fw: build sim (native_sim)",
      "type": "shell",
      "command": "just simboard=native_sim fw-sim",
      "problemMatcher": ["$gcc"]
    },
    {
      // Backgrounded so the debugger can connect while it keeps running. The
      // problemMatcher pattern below is what tells VSCode the server is up;
      // without it the launch hangs waiting for the task to "finish".
      "label": "fw: sim debugserver",
      "type": "shell",
      "command": "just fw-sim-debug",
      "isBackground": true,
      "problemMatcher": {
        "pattern": [{ "regexp": ".", "file": 1, "location": 2, "message": 3 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*(qemu|gdbserver|listening|1234).*"
        }
      }
    },
    {
      "label": "fw: flash (debug -O0)",
      "type": "shell",
      "command": "just fw-flash-debug",
      "problemMatcher": ["$gcc"]
    },
    {
      // The one to open during a debug session. Reads the CDC-ACM on the USB
      // jack, where debug.overlay puts the console; "fw: monitor" would open
      // the UART jack and reset the chip out from under gdb.
      "label": "fw: monitor (debug, USB jack)",
      "type": "shell",
      "command": "just fw-monitor-debug",
      "presentation": { "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      // Via just, not west directly: the justfile is what exports
      // ZEPHYR_SDK_INSTALL_DIR and puts .venv/bin on PATH, and west needs both.
      //
      // fw-debug flashes then serves, so the image on the chip is the same
      // -O0 build as the elf gdb reads symbols from. Skip that and breakpoints
      // land on the wrong lines with no visible complaint from either side.
      //
      // One task rather than dependsOn: each VSCode task is its own `just`
      // process, and just only dedupes dependencies within one invocation, so
      // chaining them built twice.
      "label": "fw: openocd server",
      "type": "shell",
      "command": "just fw-debug",
      "isBackground": true,
      "problemMatcher": {
        "pattern": [{ "regexp": ".", "file": 1, "location": 2, "message": 3 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Open On-Chip Debugger.*",
          "endsPattern": ".*Listening on port 3333.*"
        }
      }
    },
    {
      "label": "fmt: all",
      "type": "shell",
      "command": "just fmt",
      "problemMatcher": []
    },
    {
      "label": "test: everything",
      "type": "shell",
      "command": "just test",
      "problemMatcher": []
    }
  ]
}
