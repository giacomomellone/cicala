{
  // Use Zephyr's generated per-file flags and Kconfig definitions.
  "version": 4,
  "configurations": [
    {
      "name": "zephyr (esp32s3)",
      "compileCommands": "${workspaceFolder}/build/esp32s3/compile_commands.json",
      // Fallback for files absent from compile_commands.json.
      "includePath": ["${workspaceFolder}/firmware/**"],
      "cStandard": "c11",
      "cppStandard": "c++17"
    }
  ]
}
