{
  "version": "0.2.0",
  "configurations": [
    {
      // qemu runs the -Og image and waits for gdb on port 1234.
      "name": "sim: debug (qemu)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/sim-debug/zephyr/zephyr.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${config:cicala.gdbSim}",
      "miDebuggerServerAddress": "localhost:1234",
      "stopAtConnect": true,
      "preLaunchTask": "fw: sim debugserver",
      "setupCommands": [
        { "text": "set print pretty on" },
        { "text": "set confirm off" }
      ],
      // Stop in application code after the reset vector.
      "postRemoteConnectCommands": [{ "text": "tbreak main" }]
    },
    {
      // The DevKitC's built-in USB-JTAG serves OpenOCD on port 3333.
      "name": "devkit: debug (OpenOCD)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/esp32s3-debug/zephyr/zephyr.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${config:cicala.gdbTarget}",
      "miDebuggerServerAddress": "localhost:3333",
      "preLaunchTask": "fw: openocd server",
      // Resume after the reset command and stop at user breakpoints.
      "stopAtConnect": false,
      // setupCommands run before the remote target is attached.
      "setupCommands": [
        { "text": "set remote hardware-watchpoint-limit 2" },
        { "text": "set print pretty on" }
      ],
      // Target monitor commands require an attached remote.
      "postRemoteConnectCommands": [
        { "text": "monitor reset halt" },
        // Reset invalidates gdb's cached register values.
        { "text": "maintenance flush register-cache" }
      ],
      "logging": { "engineLogging": false }
    },
    {
      // Attach to an OpenOCD server already running on port 3333.
      "name": "devkit: attach (OpenOCD already running)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/esp32s3-debug/zephyr/zephyr.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${config:cicala.gdbTarget}",
      "miDebuggerServerAddress": "localhost:3333",
      "stopAtConnect": true,
      // Halt after attaching to the remote target.
      "postRemoteConnectCommands": [
        { "text": "monitor halt" },
        { "text": "maintenance flush register-cache" }
      ]
    },
    {
      // native_sim is a Linux host executable.
      "name": "sim: debug (native_sim, Linux only)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/sim/zephyr/zephyr.exe",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "stopAtEntry": false,
      "preLaunchTask": "fw: build sim (native_sim)"
    }
  ]
}
