{
  "version": "0.2.0",
  "configurations": [
    {
      // Host debugging. `just fw-sim-debug` builds for qemu and starts a gdb
      // server on :1234 with the CPU halted, so breakpoints in main() hit.
      "name": "sim: debug (qemu)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/sim/zephyr/zephyr.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${config:tischkarte.gdbSim}",
      "miDebuggerServerAddress": "localhost:1234",
      "preLaunchTask": "fw: sim debugserver",
      "stopAtConnect": true,
      "setupCommands": [
        { "text": "set print pretty on" },
        { "text": "set confirm off" }
      ]
    },
    {
      // On-target debugging over the DevKitC's built-in USB-JTAG. No external
      // probe needed. `west debugserver` starts OpenOCD on :3333.
      "name": "devkit: debug (OpenOCD)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/esp32s3/zephyr/zephyr.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${config:tischkarte.gdbTarget}",
      "miDebuggerServerAddress": "localhost:3333",
      "preLaunchTask": "fw: openocd server",
      "stopAtConnect": true,
      "setupCommands": [
        { "text": "set remote hardware-watchpoint-limit 2" },
        { "text": "monitor reset halt" },
        { "text": "flushregs" },
        { "text": "set print pretty on" }
      ],
      "logging": { "engineLogging": false }
    },
    {
      // Attach to an already-running OpenOCD (started by `west debugserver`
      // in a terminal). Use when reflashing repeatedly and you do not want
      // the server restarted each time.
      "name": "devkit: attach (OpenOCD already running)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/esp32s3/zephyr/zephyr.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${config:tischkarte.gdbTarget}",
      "miDebuggerServerAddress": "localhost:3333",
      "stopAtConnect": true,
      "setupCommands": [{ "text": "monitor halt" }, { "text": "flushregs" }]
    },
    {
      // Linux hosts only — native_sim produces a plain host executable, so it
      // debugs like any native binary and is much faster than qemu.
      "name": "sim: debug (native_sim, Linux only)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/sim/zephyr/zephyr.exe",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "stopAtEntry": false,
      "preLaunchTask": "fw: build sim (native_sim)"
    }
  ]
}
