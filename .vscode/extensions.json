{
  "recommendations": [
    // C/C++ — clangd rather than ms-vscode.cpptools: it reads the
    // compile_commands.json west generates, so devicetree-generated headers
    // and Kconfig defines resolve without hand-maintaining include paths.
    "llvm-vs-code-extensions.vscode-clangd",
    // cpptools is still needed for the cppdbg debug adapter in launch.json.
    "ms-vscode.cpptools",

    // Zephyr file types
    "trond-snekvik.devicetree",
    "trond-snekvik.kconfig-lang",

    "editorconfig.editorconfig",
    "charliermarsh.ruff",
    "esbenp.prettier-vscode",
    "astro-build.astro-vscode",
    "nefrob.vscode-just-syntax"
  ],
  "unwantedRecommendations": [
    // Conflicts with clangd's own indexer; keep cpptools installed for the
    // debugger but let clangd own IntelliSense.
    "ms-vscode.cpptools-extension-pack"
  ]
}
